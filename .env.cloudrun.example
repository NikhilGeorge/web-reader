# Example environment variables for Google Cloud Run deployment with OAuth
# Copy this file and fill in your actual values

# REQUIRED: Security - Generate a random secret key for JWT tokens
SECRET_KEY=your-production-secret-key-change-this-to-random-string

# REQUIRED: Google OAuth Configuration
ENABLE_GOOGLE_OAUTH=True
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-app-name.run.app/api/auth/google/callback
ALLOWED_EMAILS=your-email@gmail.com

# Optional: Override defaults (usually not needed)
# DEBUG=False
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# CORS_ORIGINS=["https://your-app-name.run.app"]
