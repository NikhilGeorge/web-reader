# Application Settings
APP_NAME=Web Reader
APP_VERSION=1.0.0
DEBUG=false

# Security - IMPORTANT: Change this in production!
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Authentication (set DISABLE_AUTH=true for testing without login)
DISABLE_AUTH=false
DEFAULT_USER=demo

# File Storage
DATA_PATH=/app/data

# CORS - Adjust based on your deployment
CORS_ORIGINS=["*"]
